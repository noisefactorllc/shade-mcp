{
  "name": "shade-mcp",
  "version": "0.4.0",
  "description": "MCP server for shader effect development",
  "type": "module",
  "license": "MIT",
  "author": "Noise Factor LLC",
  "homepage": "https://github.com/noisefactorllc/shade-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noisefactorllc/shade-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/noisefactorllc/shade-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "shader",
    "glsl",
    "wgsl",
    "webgl",
    "webgpu",
    "creative-coding",
    "noisemaker"
  ],
  "main": "dist/index.js",
  "bin": {
    "shade-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "import": "./dist/harness/index.js"
    },
    "./formats": {
      "types": "./dist/formats/index.d.ts",
      "import": "./dist/formats/index.js"
    },
    "./ai": {
      "types": "./dist/ai/provider.d.ts",
      "import": "./dist/ai/provider.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "import": "./dist/analysis/index.js"
    },
    "./knowledge": {
      "types": "./dist/knowledge/index.d.ts",
      "import": "./dist/knowledge/index.js"
    }
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "postbuild": "node -e \"import{readFileSync as r,writeFileSync as w}from'fs';const f='dist/index.js';w(f,'#!/usr/bin/env node\\n'+r(f,'utf8'))\" && npm run check:dist && npm run check:drop",
    "check:dist": "node scripts/check-dist-externals.mjs",
    "check:drop": "node scripts/check-dist-selfcontained.mjs",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "setup": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acorn": "^8.19.0",
    "openai": "^7.27.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
